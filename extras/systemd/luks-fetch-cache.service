[Unit]
Description=Cache LUKS keyslot params for fastfetch
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/luks-fetch-cache

# No [Install] section on purpose: this unit is driven by luks-fetch-cache.timer
# (whose OnBootSec covers the boot-time run). Enabling the service directly as
# well would run the sweep twice at every boot.

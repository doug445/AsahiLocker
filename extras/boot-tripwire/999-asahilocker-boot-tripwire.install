#
# 999-asahilocker-boot-tripwire.install — kernel-install plugin of the boot
# tripwire, installed to /etc/kernel/install.d/.
#
# After a kernel is added or removed, record /boot and the EFI partition, so a
# crash or power cut before the next clean shutdown is not reported as a change
# nobody made. The name sorts after 99-grub-mkconfig.install, so by now the
# kernel, the initramfs, the boot entry, m1n1 (15-update-m1n1.install on
# Fedora Asahi Remix) and grub.cfg have all been written. It records only on a
# boot whose check came back clean (record --auto), and it never fails: a
# tripwire problem must not fail a kernel installation.
case "${1:-}" in
    add|remove) ;;
    *) exit 0 ;;
esac
TOOL=${TRIPWIRE_TOOL:-/usr/local/sbin/asahilocker-boot-tripwire}
[ -x "$TOOL" ] && "$TOOL" record --auto "kernel-install $1" >/dev/null 2>&1
exit 0
